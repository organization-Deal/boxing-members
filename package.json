{
  "name": "deal-boxing-membership",
  "private": true,
  "version": "0.1.0",
  "description": "LINE LIFF boxing club membership starter on Cloudflare Workers + D1. No payment integration.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply boxing-members --local",
    "db:migrate:remote": "wrangler d1 migrations apply boxing-members --remote",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
